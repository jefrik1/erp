FROM node:20-alpine as build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps || npm install --legacy-peer-deps
COPY . .
RUN npm run build

# Sertifikat TLS: pakai yang ada di docker/certs (CA asli / self-signed),
# kalau belum ada buat self-signed saat build supaya nginx tidak gagal start.
RUN mkdir -p /certs &&     if [ -f docker/certs/fullchain.pem ] && [ -f docker/certs/privkey.pem ]; then       cp docker/certs/fullchain.pem docker/certs/privkey.pem /certs/ && echo "[tls] memakai sertifikat repo";     else       apk add --no-cache openssl >/dev/null &&       openssl req -x509 -nodes -newkey rsa:2048 -days 825         -keyout /certs/privkey.pem -out /certs/fullchain.pem         -subj "/C=ID/ST=Jawa Timur/L=Gresik/O=PT Sumber Material Jaya/CN=localhost"         -addext "subjectAltName=DNS:localhost,DNS:erp.local,IP:127.0.0.1" &&       echo "[tls] self-signed dibuat saat build";     fi

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY --from=build /certs /etc/nginx/certs
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80 443
