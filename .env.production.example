# ── Template produksi ERP Sumber Material Jaya ────────────────────────────────
# Salin ke .env.production di server (chmod 600). JANGAN commit file hasil salinan.
NODE_ENV=production
PORT=4000
TRUST_PROXY=1
# Domain asli, pisahkan dengan koma. Jangan pernah biarkan kosong di produksi.
ALLOWED_ORIGINS=https://erp.sumbermaterialjaya.co.id
# Rahasia wajib ≥32 karakter acak (openssl rand -hex 32). Backend menolak nilai default.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=8h
# Database: gunakan host internal compose (bukan localhost) dan role aplikasi.
DATABASE_URL=postgres://erp_app:CHANGE_ME@erp_postgres:5432/erp_db
REDIS_URL=redis://:CHANGE_ME@erp_redis:6379
# Backup terenkripsi off-site (S3-compatible) — lihat docs/DR-RUNBOOK.md
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_GPG_RECIPIENT=
# Observability
SENTRY_DSN=
ALERT_WEBHOOK_URL=
# Skrip perbaikan data: hanya aktif saat operasi terjadwal, lalu hapus.
ALLOW_LEDGER_REPAIR=0
