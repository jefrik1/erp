# Backend
DATABASE_URL=postgres://erp:erp_secret@postgres:5432/erp_db
PORT=4000
NODE_ENV=development

# ── WAJIB DIGANTI DI PRODUKSI (>= 32 karakter acak) ─────────────────────────
# Backend menolak boot bila NODE_ENV=production dan masih memakai nilai default.
# Generate: openssl rand -hex 32
JWT_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>

# ── Keamanan & jaringan ─────────────────────────────────────────────────────
# Origin yang boleh memanggil API (pisahkan koma). Kosong = default localhost.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Set 0 bila backend TIDAK di belakang reverse proxy (mempengaruhi IP rate-limit).
TRUST_PROXY=1
RATE_LIMIT_PER_MIN=600
LOGIN_RATE_MAX=20
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
APP_VERSION=1.0.0

# ── Integrasi (opsional; kosong = mode console, pesan tidak benar-benar terkirim) ──
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMTP_URL=
SMTP_TOKEN=

REDIS_URL=redis://redis:6379
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:4000/api

# Postgres
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_secret
POSTGRES_DB=erp_db
