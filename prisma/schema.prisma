generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String              @id @default(cuid())
  sku            String              @unique
  name           String
  category       String
  isDimension    Boolean             @default(false)
  dimensionUnit  String              @default("m")
  minStock       Float               @default(0)
  buyPrice       Float               @default(0)
  createdAt      DateTime            @default(now())
  units          ProductUnit[]
  prices         ProductPrice[]
  ledger         StockLedger[]
  soItems        SalesOrderItem[]
  poItems        PurchaseOrderItem[]
}

model ProductUnit {
  id               String              @id @default(cuid())
  productId        String
  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitName         String
  conversionFactor Float
  isBase           Boolean             @default(false)
  barcode          String?             @unique
  prices           ProductPrice[]
  ledger           StockLedger[]
  soItems          SalesOrderItem[]
  poItems          PurchaseOrderItem[]
}

model ProductPrice {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId    String
  unit      ProductUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tier      String
  price     Float
  @@unique([productId, unitId, tier])
}

model Warehouse {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  address   String?
  bins      WarehouseBin[]
  ledger    StockLedger[]
  receipts  GoodsReceipt[]
}

model WarehouseBin {
  id          String   @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  binCode     String
  ledger      StockLedger[]
  @@unique([warehouseId, binCode])
}

model StockLedger {
  id             String        @id @default(cuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  unitId         String
  unit           ProductUnit   @relation(fields: [unitId], references: [id])
  warehouseId    String
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id])
  binId          String?
  bin            WarehouseBin? @relation(fields: [binId], references: [id])
  quantityChange Float
  referenceType  String
  referenceId    String
  createdAt      DateTime      @default(now())
}

model Customer {
  id               String      @id @default(cuid())
  code             String      @unique
  name             String
  customerType     String
  phone            String?
  npwp             String?
  creditLimit      Float       @default(0)
  currentBalance   Float       @default(0)
  paymentTerms     Int         @default(0)
  isBlocked        Boolean     @default(false)
  blockedReason    String?
  overdueDays      Int         @default(0)
  salesOrders      SalesOrder[]
  invoices         Invoice[]
}

model Supplier {
  id       String          @id @default(cuid())
  code     String          @unique
  name     String
  phone    String?
  address  String?
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  orderDate   DateTime            @default(now())
  status      String              @default("Draft")
  totalAmount Float               @default(0)
  items       PurchaseOrderItem[]
  receipts    GoodsReceipt[]
}

model PurchaseOrderItem {
  id        String      @id @default(cuid())
  poId      String
  po        PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  unitId    String
  unit      ProductUnit @relation(fields: [unitId], references: [id])
  quantity  Float
  unitPrice Float
  length    Float?
  width     Float?
  subtotal  Float
}

model GoodsReceipt {
  id          String   @id @default(cuid())
  grNumber    String   @unique
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  receivedAt  DateTime @default(now())
  status      String   @default("Received")
}

model SalesOrder {
  id           String           @id @default(cuid())
  soNumber     String           @unique
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id])
  salesperson  String
  orderDate    DateTime         @default(now())
  status       String           @default("Draft")
  totalAmount  Float
  items        SalesOrderItem[]
  deliveryOrders DeliveryOrder[]
  invoice      Invoice?
}

model SalesOrderItem {
  id        String      @id @default(cuid())
  soId      String
  so        SalesOrder  @relation(fields: [soId], references: [id], onDelete: Cascade)
  productId String
  product   Product     @relation(fields: [productId], references: [id])
  unitId    String
  unit      ProductUnit @relation(fields: [unitId], references: [id])
  quantity  Float
  unitPrice Float
  length    Float?
  width     Float?
  subtotal  Float
}

model DeliveryOrder {
  id            String     @id @default(cuid())
  doNumber      String     @unique
  soId          String
  so            SalesOrder @relation(fields: [soId], references: [id])
  driver        String
  vehicle       String
  status        String     @default("Scheduled")
  tare          Float?
  gross         Float?
  netto         Float?
  podUrl        String?
  deliveredAt   DateTime?
}

model Invoice {
  id         String   @id @default(cuid())
  invNumber  String   @unique
  soId       String   @unique
  so         SalesOrder @relation(fields: [soId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  dpp        Float
  dppLain    Float
  ppn        Float
  total      Float
  dueDate    DateTime
  status     String   @default("Unpaid")
}
