{
  "name": "erp-material",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev:backend": "node --watch src/index.js",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:frontend": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "dev:all": "concurrently \"npm run dev:backend\" \"vite --host 0.0.0.0 --port 5173\"",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "test:rbac": "node --test \"tests/*.test.js\"",
    "provision:accounts": "node scripts/provision-employee-accounts.mjs",
    "verify:rbac": "node scripts/verify-employee-rbac.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "test:api": "node --test tests/api-smoke.test.js",
    "audit:data": "node scripts/audit-inventory-data.mjs",
    "fix:data": "node scripts/fix-inventory-data.mjs",
    "repair:ledger": "node scripts/repair-ledger.mjs",
    "recon:gl": "node scripts/reconcile-gl-inventory.mjs",
    "verify:golive": "node scripts/production-cutover-check.mjs",
    "f16:dry": "node scripts/f16-pos-backfill.mjs",
    "f16:apply": "node scripts/f16-pos-backfill.mjs --apply",
    "status:report": "node scripts/status-report.mjs",
    "golive:prod": "node scripts/production-cutover-check.mjs --profile=production",
    "demo:off": "node scripts/disable-demo-accounts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.363.0",
    "morgan": "^1.10.0",
    "motion": "^14.2.0",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "vite": "^7.3.6"
  }
}
