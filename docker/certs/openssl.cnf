[req]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
x509_extensions    = v3_req

[dn]
C  = ID
ST = Jawa Timur
L  = Gresik
O  = PT Sumber Material Jaya
CN = erp.local

[v3_req]
subjectAltName   = @alt
keyUsage         = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
basicConstraints = CA:FALSE

[alt]
DNS.1 = erp.local
DNS.2 = localhost
IP.1  = 127.0.0.1
